diff --git a/fabric/src/main/java/dev/skycraft/combat/MobAggro.java b/fabric/src/main/java/dev/skycraft/combat/MobAggro.java
new file mode 100644
index 0000000..3118418
--- /dev/null
+++ b/fabric/src/main/java/dev/skycraft/combat/MobAggro.java
@@ -0,0 +1,54 @@
+package dev.skycraft.combat;
+
+import dev.skycraft.link.SkyLink;
+import java.util.Collection;
+import java.util.HashSet;
+import java.util.Set;
+import net.minecraft.server.level.ServerLevel;
+import net.minecraft.world.entity.Mob;
+
+/**
+ * Hostile Minecraft mobs go for Skyrim's NPCs as hard as they would a player: any mob with no target
+ * that has an NPC (its stand-in) within reach of its senses takes the nearest one, through walls or
+ * not (SkyrimChaseGoal gets it there), and keeps at it. Done here, once for every mob near an NPC,
+ * rather than in a goal, so no other targeting goal of the mob's can talk it out of it.
+ */
+final class MobAggro {
+	private static final double RANGE = 32.0;
+
+	private MobAggro() {
+	}
+
+	static void tick(ServerLevel level, Collection<SkyrimActorEntity> actors) {
+		if (!SkyLink.active() || actors.isEmpty()) {
+			return;
+		}
+		Set<Mob> done = new HashSet<>();
+		for (SkyrimActorEntity npc : actors) {
+			if (!npc.isAlive()) {
+				continue;
+			}
+			for (Mob mob : level.getEntitiesOfClass(Mob.class, npc.getBoundingBox().inflate(RANGE, 10.0, RANGE), AttackSkyrimActorsGoal::wants)) {
+				if (!mob.isAlive() || mob.isPassenger() || !done.add(mob)) {
+					continue;
+				}
+				var target = mob.getTarget();
+				if (target != null && target.isAlive()) {
+					continue;
+				}
+				SkyrimActorEntity nearest = null;
+				double best = RANGE * RANGE;
+				for (SkyrimActorEntity other : actors) {
+					double d = other.isAlive() && Math.abs(other.getY() - mob.getY()) < 10.0 ? mob.distanceToSqr(other) : Double.MAX_VALUE;
+					if (d < best) {
+						best = d;
+						nearest = other;
+					}
+				}
+				if (nearest != null) {
+					mob.setTarget(nearest);
+				}
+			}
+		}
+	}
+}
