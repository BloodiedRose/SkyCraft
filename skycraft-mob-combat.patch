diff --git a/fabric/src/main/java/dev/skycraft/combat/SkyrimStrikes.java b/fabric/src/main/java/dev/skycraft/combat/SkyrimStrikes.java
new file mode 100644
index 0000000..17ae8f1
--- /dev/null
+++ b/fabric/src/main/java/dev/skycraft/combat/SkyrimStrikes.java
@@ -0,0 +1,62 @@
+package dev.skycraft.combat;
+
+import dev.skycraft.link.SkyLink;
+import java.util.List;
+import net.minecraft.server.level.ServerLevel;
+import net.minecraft.server.level.ServerPlayer;
+import net.minecraft.world.entity.Mob;
+import net.minecraft.world.phys.AABB;
+import net.minecraft.world.phys.Vec3;
+
+/**
+ * The player's own Skyrim weapon against Minecraft mobs (Skyrim controls). Skyrim's blade and arrows
+ * pass through a mob, which Skyrim knows nothing about, so Skyrim reports each swing or release with the
+ * weapon's damage and this finds the mob in the way along the player's look and hurts it as the player.
+ */
+public final class SkyrimStrikes {
+	/** Skyrim weapon damage to Minecraft damage (an iron sword's 7 is about a stone sword's 5). */
+	private static final float SKYRIM_TO_MC = 0.75F;
+	private static final double MELEE_REACH = 3.0;
+	private static final double ARROW_RANGE = 48.0;
+
+	private SkyrimStrikes() {
+	}
+
+	/** {@code kind}: 0 melee, 1 arrow. Runs on the server thread. */
+	public static void strike(ServerPlayer player, int kind, float skyrimDamage) {
+		if (!player.isAlive() || !SkyLink.active() || !(player.level() instanceof ServerLevel level)) {
+			return;
+		}
+		Vec3 eye = player.getEyePosition();
+		Vec3 look = player.getLookAngle();
+		double reach = kind == 1 ? ARROW_RANGE : MELEE_REACH;
+		Vec3 end = eye.add(look.scale(reach));
+		List<Mob> mobs = level.getEntitiesOfClass(Mob.class, new AABB(eye, end).inflate(1.5), Mob::isAlive);
+		Mob best = null;
+		double bestDist = Double.MAX_VALUE;
+		for (Mob mob : mobs) {
+			double d;
+			if (kind == 1) {
+				var hit = mob.getBoundingBox().inflate(0.3).clip(eye, end);
+				if (hit.isEmpty()) {
+					continue;
+				}
+				d = eye.distanceTo(hit.get());
+			} else {
+				Vec3 to = mob.getBoundingBox().getCenter().subtract(eye);
+				double dist = to.length() - mob.getBbWidth() * 0.5;
+				if (dist > reach || to.normalize().dot(look) < 0.55) {
+					continue;
+				}
+				d = dist;
+			}
+			if (d < bestDist && SkyrimMobs.canSee(player, mob)) {
+				best = mob;
+				bestDist = d;
+			}
+		}
+		if (best != null) {
+			best.hurtServer(level, level.damageSources().playerAttack(player), Math.max(1.0F, skyrimDamage * SKYRIM_TO_MC));
+		}
+	}
+}
