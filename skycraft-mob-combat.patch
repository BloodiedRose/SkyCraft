+	private static java.lang.reflect.Field findImmunity() {
+		for (Class<?> c = SkyrimActorEntity.class; c != null; c = c.getSuperclass()) {
+			try {
+				java.lang.reflect.Field f = c.getDeclaredField("invulnerableTime");
