@@ -0,0 +1,69 @@
+package dev.skycraft.combat;
+
+import dev.skycraft.link.Proto;
+import dev.skycraft.link.SkyLink;
+import java.util.Collection;
+import java.util.HashMap;
+import java.util.Map;
+import net.minecraft.server.level.ServerLevel;
+import net.minecraft.world.entity.Mob;
+import net.minecraft.world.entity.MobCategory;
+
+/**
+ * Skyrim's NPCs fight the Minecraft mobs that go for them. Skyrim's own AI has no idea a zombie
+ * exists, so it would stand there and take it; this makes a fighter (anyone with a fighting streak,
+ * not a shopkeeper) turn on the mob once it is in reach and hit it with the NPC's stand-in's blows,
+ * through Minecraft's own damage ({@code mobAttack}: armour, knockback, the mob hitting back at the NPC
+ * in turn). Skyrim is told to turn the NPC to face the mob and play its attack swing
+ * ({@link Proto#EV_NPC_SWING}), so it looks like the NPC's own blow.
+ *
+ * <p>It only answers: a mob that's after the NPC, or a hostile one that has come close. The NPC
+ * doesn't leave its place to chase one. Turn it off with the JVM argument {@code -Dskycraft.npcsFightBack=false}.
+ */
+final class NpcFightsBack {
+	private static final boolean ENABLED = !"false".equalsIgnoreCase(System.getProperty("skycraft.npcsFightBack"));
+	/** How far past its own body an NPC's blow reaches, in blocks. */
+	private static final double REACH = 2.2;
+	/** Anyone shorter than this (children, small creatures) keeps out of it. */
+	private static final float MIN_HEIGHT = 1.2F;
+	private static final Map<Integer, Long> READY_AT = new HashMap<>();
+
+	private NpcFightsBack() {
+	}
+
+	static void tick(ServerLevel level, Collection<SkyrimActorEntity> actors) {
+		if (!ENABLED || !SkyLink.active()) {
+			return;
+		}
+		long now = level.getGameTime();
+		READY_AT.values().removeIf(at -> at < now - 200);
+		for (SkyrimActorEntity npc : actors) {
+			if (!npc.isAlive() || !npc.fighter() || npc.inSkyrimCombat() || npc.getBbHeight() < MIN_HEIGHT) {
+				continue;
+			}
+			Long ready = READY_AT.get(npc.formId());
+			if (ready != null && now < ready) {
+				continue;
+			}
+			Mob best = null;
+			double bestGap = Double.MAX_VALUE;
+			for (Mob mob : level.getEntitiesOfClass(Mob.class, npc.getBoundingBox().inflate(REACH + 1.5, 1.5, REACH + 1.5))) {
+				if (!mob.isAlive() || !(mob.getType().getCategory() == MobCategory.MONSTER || mob.getTarget() == npc)) {
+					continue;
+				}
+				double gap = Math.hypot(mob.getX() - npc.getX(), mob.getZ() - npc.getZ()) - npc.getBbWidth() * 0.5 - mob.getBbWidth() * 0.5;
+				if (gap < REACH && gap < bestGap && Math.abs(mob.getY() - npc.getY()) < npc.getBbHeight() && SkyrimMobs.canSee(npc, mob)) {
+					best = mob;
+					bestGap = gap;
+				}
+			}
+			if (best == null) {
+				continue;
+			}
+			float damage = 3.0F + npc.getRandom().nextFloat() * 3.0F;
+			best.hurtServer(level, level.damageSources().mobAttack(npc), damage);
+			SkyLink.pushEvent(Proto.EV_NPC_SWING, npc.formId(), (float) best.getX(), (float) best.getY(), (float) best.getZ(), 0.0F, 0);
+			READY_AT.put(npc.formId(), now + 20 + npc.getRandom().nextInt(16));
+		}
+	}
+}
