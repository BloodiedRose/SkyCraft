diff --git a/fabric/src/main/java/dev/skycraft/combat/SkyrimChaseGoal.java b/fabric/src/main/java/dev/skycraft/combat/SkyrimChaseGoal.java
new file mode 100644
index 0000000..98f72ff
--- /dev/null
+++ b/fabric/src/main/java/dev/skycraft/combat/SkyrimChaseGoal.java
@@ -0,0 +1,104 @@
+package dev.skycraft.combat;
+
+import dev.skycraft.link.SkyLink;
+import dev.skycraft.world.SkyNav;
+import dev.skycraft.world.SkyTri;
+import java.util.List;
+import net.minecraft.server.level.ServerLevel;
+import net.minecraft.world.entity.LivingEntity;
+import net.minecraft.world.entity.Mob;
+import net.minecraft.world.entity.ai.goal.Goal;
+import net.minecraft.world.item.BowItem;
+import net.minecraft.world.item.CrossbowItem;
+
+/**
+ * A Minecraft mob with something to fight walks at it over Skyrim's ground, whoever it is (a player,
+ * one of Skyrim's NPCs). Minecraft's attack goals walk a mob by asking the pathfinder for a route, and
+ * it can't see Skyrim's land, so a mob after a player stood still until the player came into its reach.
+ * When Minecraft has no route of its own, this walks the mob at its target with the mob's own move
+ * control, over Skyrim's triangles and round what's in the way ({@link SkyNav}); the mob's attack
+ * goals do the rest once it's close. This goal holds no goal flags, so it never keeps those from running.
+ *
+ * <p>Turn it off with the JVM argument {@code -Dskycraft.mobsRoam=false}.
+ */
+public final class SkyrimChaseGoal extends Goal {
+	private static final boolean ENABLED = !"false".equalsIgnoreCase(System.getProperty("skycraft.mobsRoam"));
+	/** A target farther than this is left alone (Minecraft's own targeting gives up around here too). */
+	private static final double GIVE_UP = 40.0;
+	/** Archers stop walking at this distance if they can see the target, and shoot. */
+	private static final double SHOOT_FROM = 11.0;
+
+	private final Mob mob;
+	private final SkyNav.Steer steer = new SkyNav.Steer(true);
+	private double[] wanted;
+
+	public SkyrimChaseGoal(Mob mob) {
+		this.mob = mob;
+	}
+
+	public static boolean wants(Mob mob) {
+		return ENABLED && SkyrimMobs.eligible(mob);
+	}
+
+	@Override
+	public boolean canUse() {
+		LivingEntity target = this.mob.getTarget();
+		return SkyLink.active() && this.mob.level() instanceof ServerLevel && target != null && target.isAlive() && !this.mob.isPassenger()
+			&& this.mob.getNavigation().isDone() && SkyrimMobs.walker(this.mob);
+	}
+
+	@Override
+	public boolean canContinueToUse() {
+		LivingEntity target = this.mob.getTarget();
+		return SkyLink.active() && target != null && target.isAlive() && !this.mob.isPassenger() && this.mob.distanceToSqr(target) < GIVE_UP * GIVE_UP;
+	}
+
+	@Override
+	public void start() {
+		this.wanted = null;
+		this.steer.reset(this.mob.getRandom().nextBoolean());
+	}
+
+	@Override
+	public void stop() {
+		this.wanted = null;
+	}
+
+	// No @Override: not every version of Minecraft has this one (see SkyrimRoamGoal).
+	public boolean requiresUpdateEveryTick() {
+		return true;
+	}
+
+	@Override
+	public void tick() {
+		LivingEntity target = this.mob.getTarget();
+		if (target == null || !this.mob.getNavigation().isDone()) {
+			return; // Minecraft found a route of its own and is following it
+		}
+		double distanceSqr = this.mob.distanceToSqr(target);
+		double closeEnough = this.mob.getBbWidth() * 1.2 + target.getBbWidth() * 0.5;
+		if (distanceSqr < closeEnough * closeEnough) {
+			return; // arrived: the mob's attack goals take over
+		}
+		var held = this.mob.getMainHandItem().getItem();
+		if ((held instanceof BowItem || held instanceof CrossbowItem) && distanceSqr < SHOOT_FROM * SHOOT_FROM && this.mob.getSensing().hasLineOfSight(target)) {
+			return; // archers keep their distance and shoot
+		}
+		if (!this.mob.onGround()) {
+			if (this.wanted != null) { // mid-jump or falling: carry on the way it was going
+				this.mob.getMoveControl().setWantedPosition(this.wanted[0], this.wanted[1], this.wanted[2], 1.0);
+			}
+			return;
+		}
+		List<SkyTri> tris = SkyrimMobs.trianglesAround(this.mob, SkyNav.REACH, SkyNav.BELOW, SkyNav.ABOVE);
+		double[] next = this.steer.next(
+			tris, SkyrimMobs.hazard(this.mob), this.mob.getX(), this.mob.getY(), this.mob.getZ(), this.mob.getBbWidth() * 0.5, this.mob.getBbHeight(),
+			this.mob.maxUpStep(), target.getX(), target.getZ()
+		);
+		if (next == null) {
+			return; // boxed in (a cliff edge, a wall all round): it waits for the target to move
+		}
+		this.wanted = next;
+		this.mob.getMoveControl().setWantedPosition(next[0], next[1], next[2], 1.0);
+	}
+}
diff --git a/fabric/src/main/java/dev/skycraft/combat/SkyrimMobs.java b/fabric/src/main/java/dev/skycraft/combat/SkyrimMobs.java
new file mode 100644
index 0000000..3146c2a
--- /dev/null
+++ b/fabric/src/main/java/dev/skycraft/combat/SkyrimMobs.java
@@ -0,0 +1,70 @@
+package dev.skycraft.combat;
+
+import dev.skycraft.world.SkyCollision;
+import dev.skycraft.world.SkyNav;
+import dev.skycraft.world.SkyTri;
+import dev.skycraft.world.SkyWater;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Set;
+import net.minecraft.core.BlockPos;
+import net.minecraft.core.registries.BuiltInRegistries;
+import net.minecraft.world.entity.Mob;
+import net.minecraft.world.entity.ai.control.MoveControl;
+import net.minecraft.world.level.Level;
+import net.minecraft.world.phys.AABB;
+
+/** What {@link SkyrimRoamGoal} and {@link SkyrimChaseGoal} share: which mobs they're for, and what a mob sees of Skyrim around it. */
+final class SkyrimMobs {
+	/**
+	 * Mobs that don't walk the way a plain land mob does, or that run their own brain and walk
+	 * targets: left alone, they would fight what the goals ask of them.
+	 */
+	private static final Set<String> OWN_MOVEMENT = Set.of(
+		"villager", "piglin", "piglin_brute", "zoglin", "hoglin", "warden", "breeze", "creaking", "allay", "axolotl", "frog", "tadpole", "goat", "camel",
+		"camel_husk", "sniffer", "armadillo", "happy_ghast", "strider", "enderman", "shulker", "ender_dragon", "wither", "giant"
+	);
+
+	private SkyrimMobs() {
+	}
+
+	/** A mob the goals may help at all (the property {@code skycraft.mobsRoam=false} turns them off elsewhere). */
+	static boolean eligible(Mob mob) {
+		return !OWN_MOVEMENT.contains(BuiltInRegistries.ENTITY_TYPE.getKey(mob.getType()).getPath());
+	}
+
+	/**
+	 * Mobs that get about on foot with the plain move control: zombies, skeletons, spiders, creepers,
+	 * cows, pigs, sheep, wolves, horses. Flyers, swimmers, hoppers (slimes, rabbits) and the rest
+	 * have their own move control, which ours would only fight. A mob only has its final move control
+	 * once it's built, so this is asked when a goal runs, not when it's added.
+	 */
+	static boolean walker(Mob mob) {
+		return mob.getMoveControl().getClass() == MoveControl.class;
+	}
+
+	/** Skyrim's triangles around the mob: {@code reach} blocks sideways, {@code below} under its feet and {@code above} over its head. */
+	static List<SkyTri> trianglesAround(Mob mob, double reach, double below, double above) {
+		List<SkyTri> tris = new ArrayList<>();
+		SkyCollision.trianglesNear(
+			new AABB(mob.getX() - reach, mob.getY() - below, mob.getZ() - reach, mob.getX() + reach, mob.getY() + mob.getBbHeight() + above, mob.getZ() + reach), tris
+		);
+		return tris;
+	}
+
+	/** Water (Skyrim's, or Minecraft's, lava too) deep enough that a land mob shouldn't walk into it. */
+	static SkyNav.Hazard hazard(Mob mob) {
+		return (x, y, z) -> {
+			double surface = SkyWater.surfaceAt((int) Math.floor(x), (int) Math.floor(z));
+			if (!Double.isNaN(surface) && surface > y + 0.4) {
+				return true;
+			}
+			Level level = mob.level();
+			return !level.getFluidState(BlockPos.containing(x, y + 0.1, z)).isEmpty();
+		};
+	}
+
+	static boolean known(Mob mob) {
+		return SkyCollision.isKnown((int) Math.floor(mob.getX()), (int) Math.floor(mob.getY()), (int) Math.floor(mob.getZ()));
+	}
+}
diff --git a/fabric/src/main/java/dev/skycraft/combat/SkyrimRoamGoal.java b/fabric/src/main/java/dev/skycraft/combat/SkyrimRoamGoal.java
new file mode 100644
index 0000000..c0fe73b
--- /dev/null
+++ b/fabric/src/main/java/dev/skycraft/combat/SkyrimRoamGoal.java
@@ -0,0 +1,137 @@
+package dev.skycraft.combat;
+
+import dev.skycraft.link.SkyLink;
+import dev.skycraft.world.SkyNav;
+import dev.skycraft.world.SkyTri;
+import java.util.EnumSet;
+import java.util.List;
+import net.minecraft.server.level.ServerLevel;
+import net.minecraft.world.entity.Mob;
+import net.minecraft.world.entity.MobCategory;
+import net.minecraft.world.entity.ai.goal.Goal;
+
+/**
+ * Minecraft mobs wander about on Skyrim's ground as they would on Minecraft's. Minecraft's own
+ * strolling picks a spot and asks the pathfinder for a way there, which can't see Skyrim's land, so
+ * mobs stood where they spawned. This picks a spot a few blocks off that the mob can walk to in a
+ * straight line over Skyrim's triangles (no wall, cliff or deep water on the way, ledges it can jump
+ * allowed), and walks there with the mob's own move control, going round what's in the way ({@link SkyNav}).
+ * About every six seconds an idle mob sets off, like Minecraft's.
+ *
+ * <p>Turn it off with the JVM argument {@code -Dskycraft.mobsRoam=false}.
+ */
+public final class SkyrimRoamGoal extends Goal {
+	private static final boolean ENABLED = !"false".equalsIgnoreCase(System.getProperty("skycraft.mobsRoam"));
+	private static final double MIN_DISTANCE = 3.0;
+	private static final double MAX_DISTANCE = 8.0;
+	private static final int TRIES = 8;
+	private static final int MAX_TICKS = 400;
+	private static final double ARRIVED = 0.8;
+
+	private final Mob mob;
+	private final SkyNav.Steer steer = new SkyNav.Steer(true);
+	private double goalX, goalZ;
+	private int ticks;
+	private boolean finished;
+	private double[] wanted;
+
+	public SkyrimRoamGoal(Mob mob) {
+		this.mob = mob;
+		this.setFlags(EnumSet.of(Goal.Flag.MOVE));
+	}
+
+	/** Land animals and monsters. */
+	public static boolean wants(Mob mob) {
+		if (!ENABLED || !SkyrimMobs.eligible(mob)) {
+			return false;
+		}
+		MobCategory category = mob.getType().getCategory();
+		return category == MobCategory.MONSTER || category == MobCategory.CREATURE;
+	}
+
+	@Override
+	public boolean canUse() {
+		if (!SkyLink.active() || !(this.mob.level() instanceof ServerLevel) || this.mob.getTarget() != null || this.mob.isPassenger() || !this.mob.onGround()
+			|| this.mob.isInWater() || !this.mob.getNavigation().isDone() || this.mob.getRandom().nextInt(60) != 0 || !SkyrimMobs.walker(this.mob)) {
+			return false;
+		}
+		return choose();
+	}
+
+	/** A spot the mob can walk to, if one of a few tries finds it. */
+	private boolean choose() {
+		if (!SkyrimMobs.known(this.mob)) {
+			return false;
+		}
+		double x = this.mob.getX(), y = this.mob.getY(), z = this.mob.getZ();
+		List<SkyTri> tris = SkyrimMobs.trianglesAround(this.mob, MAX_DISTANCE + 1.5, SkyNav.BELOW + 3.0, SkyNav.ABOVE + 3.0);
+		if (tris.isEmpty()) {
+			return false;
+		}
+		var hazard = SkyrimMobs.hazard(this.mob);
+		var random = this.mob.getRandom();
+		double radius = this.mob.getBbWidth() * 0.5, height = this.mob.getBbHeight(), stepUp = this.mob.maxUpStep();
+		for (int i = 0; i < TRIES; i++) {
+			double angle = random.nextDouble() * (Math.PI * 2.0);
+			double distance = MIN_DISTANCE + random.nextDouble() * (MAX_DISTANCE - MIN_DISTANCE);
+			double tx = x + Math.cos(angle) * distance, tz = z + Math.sin(angle) * distance;
+			if (SkyNav.canWalk(tris, hazard, x, y, z, radius, height, stepUp, tx, tz)) {
+				this.goalX = tx;
+				this.goalZ = tz;
+				return true;
+			}
+		}
+		return false;
+	}
+
+	@Override
+	public boolean canContinueToUse() {
+		return !this.finished && this.ticks < MAX_TICKS && SkyLink.active() && this.mob.getTarget() == null && !this.mob.isPassenger()
+			&& this.mob.getNavigation().isDone();
+	}
+
+	@Override
+	public void start() {
+		this.ticks = 0;
+		this.finished = false;
+		this.wanted = null;
+		this.steer.reset(this.mob.getRandom().nextBoolean());
+	}
+
+	@Override
+	public void stop() {
+		this.wanted = null;
+	}
+
+	// No @Override: not every version of Minecraft has this one. Minecraft's move control walks one
+	// tick per order, so without it the mob would only move every other tick.
+	public boolean requiresUpdateEveryTick() {
+		return true;
+	}
+
+	@Override
+	public void tick() {
+		this.ticks++;
+		double x = this.mob.getX(), y = this.mob.getY(), z = this.mob.getZ();
+		if (Math.hypot(this.goalX - x, this.goalZ - z) < ARRIVED) {
+			this.finished = true;
+			return;
+		}
+		if (!this.mob.onGround()) {
+			if (this.wanted != null) { // mid-jump or falling: carry on the way it was going
+				this.mob.getMoveControl().setWantedPosition(this.wanted[0], this.wanted[1], this.wanted[2], 1.0);
+			}
+			return;
+		}
+		List<SkyTri> tris = SkyrimMobs.trianglesAround(this.mob, SkyNav.REACH, SkyNav.BELOW, SkyNav.ABOVE);
+		double[] next = this.steer.next(
+			tris, SkyrimMobs.hazard(this.mob), x, y, z, this.mob.getBbWidth() * 0.5, this.mob.getBbHeight(), this.mob.maxUpStep(), this.goalX, this.goalZ
+		);
+		if (next == null || this.steer.stuck()) {
+			this.finished = true; // no way on from here, or going nowhere: it'll pick another spot later
+			return;
+		}
+		this.wanted = next;
+		this.mob.getMoveControl().setWantedPosition(next[0], next[1], next[2], 1.0);
+	}
+}
