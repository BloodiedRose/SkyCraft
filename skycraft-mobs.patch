@@ -0,0 +1,105 @@
+package dev.skycraft.combat;
+
+import dev.skycraft.link.SkyLink;
+import java.util.Set;
+import net.minecraft.core.registries.BuiltInRegistries;
+import net.minecraft.server.level.ServerLevel;
+import net.minecraft.world.entity.LivingEntity;
+import net.minecraft.world.entity.Mob;
+import net.minecraft.world.entity.MobCategory;
+import net.minecraft.world.entity.ai.goal.Goal;
+import net.minecraft.world.item.BowItem;
+import net.minecraft.world.item.CrossbowItem;
+
+/**
+ * Hostile Minecraft mobs attack Skyrim's NPCs. A mob with no one else to fight picks the nearest
+ * NPC stand-in ({@link SkyrimActorEntity}) as its target, and then its own attack goals do the
+ * rest: swinging, shooting, swelling. A player in reach still takes priority (their usual targeting
+ * goals replace this target).
+ *
+ * <p>Minecraft's pathfinding can't see Skyrim's ground (it isn't blocks), so a melee mob that finds
+ * no path is walked straight at its target instead, with its own movement control; the Skyrim
+ * triangles stop it at walls, and it jumps what it can. This goal holds no goal flags, so it never
+ * keeps the mob's own attack goals from running.
+ *
+ * <p>Turn it off with the JVM argument {@code -Dskycraft.mobsAttackNpcs=false}.
+ */
+public final class AttackSkyrimActorsGoal extends Goal {
+	private static final double RANGE = 16.0;
+	private static final boolean ENABLED = !"false".equalsIgnoreCase(System.getProperty("skycraft.mobsAttackNpcs"));
+	// Mobs run by a brain or by their own scripted attacks: they choose their own targets.
+	private static final Set<String> OWN_AI = Set.of(
+		"piglin", "piglin_brute", "zoglin", "hoglin", "warden", "breeze", "creaking", "enderman", "shulker", "ender_dragon", "wither", "giant"
+	);
+
+	private final Mob mob;
+	private SkyrimActorEntity chosen;
+
+	public AttackSkyrimActorsGoal(Mob mob) {
+		this.mob = mob;
+	}
+
+	/** Hostile, goal-driven mobs. */
+	public static boolean wants(Mob mob) {
+		return ENABLED
+			&& mob.getType().getCategory() == MobCategory.MONSTER
+			&& !OWN_AI.contains(BuiltInRegistries.ENTITY_TYPE.getKey(mob.getType()).getPath());
+	}
+
+	@Override
+	public boolean canUse() {
+		if (!SkyLink.active() || !(this.mob.level() instanceof ServerLevel) || this.mob.getTarget() != null || this.mob.isPassenger()
+			|| this.mob.tickCount % 10 != 0) {
+			return false;
+		}
+		SkyrimActorEntity best = null;
+		double bestDistance = Double.MAX_VALUE;
+		for (SkyrimActorEntity actor : this.mob.level().getEntitiesOfClass(SkyrimActorEntity.class, this.mob.getBoundingBox().inflate(RANGE))) {
+			double distance = this.mob.distanceToSqr(actor);
+			if (actor.isAlive() && distance < bestDistance && Math.abs(actor.getY() - this.mob.getY()) < 8.0) {
+				best = actor;
+				bestDistance = distance;
+			}
+		}
+		this.chosen = best;
+		return best != null;
+	}
+
+	@Override
+	public boolean canContinueToUse() {
+		LivingEntity target = this.mob.getTarget();
+		return SkyLink.active() && target != null && target == this.chosen && target.isAlive() && !target.isRemoved()
+			&& this.mob.distanceToSqr(target) < RANGE * RANGE * 2.25;
+	}
+
+	@Override
+	public void start() {
+		this.mob.setTarget(this.chosen);
+	}
+
+	@Override
+	public void stop() {
+		if (this.mob.getTarget() == this.chosen) {
+			this.mob.setTarget(null);
+		}
+		this.chosen = null;
+	}
+
+	// No @Override: not every version of Minecraft has this one.
+	public boolean requiresUpdateEveryTick() {
+		return true;
+	}
+
+	@Override
+	public void tick() {
+		LivingEntity target = this.mob.getTarget();
+		if (target == null || target != this.chosen || !this.mob.getNavigation().isDone()) {
+			return; // Minecraft found a path of its own and is following it
+		}
+		var held = this.mob.getMainHandItem().getItem();
+		if (held instanceof BowItem || held instanceof CrossbowItem || this.mob.distanceToSqr(target) < 2.25) {
+			return; // archers keep their distance, and a mob next to its target has arrived
+		}
+		this.mob.getMoveControl().setWantedPosition(target.getX(), target.getY(), target.getZ(), 1.0);
+	}
+}
